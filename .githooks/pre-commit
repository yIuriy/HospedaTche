#!/bin/sh

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validate-abuse-cases.ps1
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-abuse-cases.ps1
else
  echo "PowerShell not found. Cannot validate abuse cases."
  exit 1
fi
