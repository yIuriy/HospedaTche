#!/bin/sh

MIN_LENGTH=12
MSG_FILE="$1"

first_line="$(sed -n '1p' "$MSG_FILE" | tr -d '\r')"
trimmed="$(printf '%s' "$first_line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
length=${#trimmed}
lower="$(printf '%s' "$trimmed" | tr '[:upper:]' '[:lower:]')"

case "$lower" in
  changes|change|fix|fixes|work|adjustment|adjustments|update|updates|wip|test|tests)
    echo "Commit message blocked: too generic."
    echo "Use a clear message, for example: Add STRIDE threat table"
    exit 1
    ;;
esac

if [ "$length" -le "$MIN_LENGTH" ]; then
  echo "Commit message blocked: first line must be more than $MIN_LENGTH characters."
  echo "Current first line: $trimmed"
  exit 1
fi

case "$trimmed" in
  [A-Z]*)
    ;;
  *)
    echo "Commit message blocked: first line must start with a capital letter."
    echo "Current first line: $trimmed"
    exit 1
    ;;
esac

exit 0
